<Window x:Class="NCEF_Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NCEF Browser Debugger" Height="800" Width="1200"
        Closed="Window_Closed" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="RPC ID:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBox x:Name="TxtMasterRpcId" Width="150" VerticalAlignment="Center" Text="GLOBAL_NCEF" Margin="0,0,10,0"/>
            <Button x:Name="BtnConnectMaster" Content="Connect" Width="100" Height="28" Margin="0,0,10,0" Click="BtnConnectMaster_Click"/>
            
            <Separator Width="1" Margin="10,0"/>
            
            <TextBlock Text="URL:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="TxtBrowserUrl" Width="200" VerticalAlignment="Center" Text="https://www.bing.com" Margin="0,0,5,0" 
                     TextChanged="TxtBrowserUrl_TextChanged"/>
            <TextBlock Text="W:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="TxtBrowserWidth" Width="50" VerticalAlignment="Center" Text="1280" Margin="0,0,5,0"/>
            <TextBlock Text="H:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBox x:Name="TxtBrowserHeight" Width="50" VerticalAlignment="Center" Text="720" Margin="0,0,5,0"/>
            <TextBlock Text="FPS:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBox x:Name="TxtBrowserFps" Width="40" VerticalAlignment="Center" Text="60" Margin="0,0,10,0"/>
            <Button x:Name="BtnCreateBrowser" Content="Create Browser" Width="100" Height="28" Click="BtnCreateBrowser_Click" IsEnabled="False"/>
            <Separator Width="1" Margin="10,0"/>
            <Button x:Name="SelectSpout" Content="Select Spout Name" Width="120" Height="28" Click="BtnSelectSpout_Click" IsEnabled="False"/>
            <Separator Width="1" Margin="10,0"/>
            
            <Button x:Name="BtnRunTests" Content="Run Tests" Width="80" Height="28" Click="BtnRunTests_Click" IsEnabled="False"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SpoutPreviewBorder" Grid.Column="0" Background="#1a1a1a" CornerRadius="4">
                <Image x:Name="SpoutPreviewImage" Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="TxtSpoutStatus" Grid.Column="0" Text="Not Connected"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#666" FontSize="14"/>
            <TextBlock x:Name="TxtSpoutInfo" Grid.Column="0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Foreground="#0f0" FontSize="11" Margin="5"/>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Browser Control" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="DevTools" Width="120" Height="25" Margin="0,0,0,5" Click="BtnShowDevTools_Click"/>
                <Button Content="Get URL" Width="120" Height="25" Margin="0,0,0,5" Click="BtnGetUrl_Click"/>
                <Button Content="Exec JS" Width="120" Height="25" Margin="0,0,0,5" Click="BtnExecuteJs_Click"/>
                <Button Content="Get Cursor" Width="120" Height="25" Margin="0,0,0,5" Click="BtnGetCursorType_Click"/>
                <Separator Margin="0,10"/>
                <TextBlock Text="Status" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="SpoutId:" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtCurrentSpoutId" IsReadOnly="True" Height="23" Margin="0,0,0,5"/>
                <TextBlock Text="Size:" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtFrameSize" IsReadOnly="True" Height="23" Margin="0,0,0,5"/>
                <TextBlock Text="FPS:" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtFps" IsReadOnly="True" Height="23"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="Log">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Expander Grid.Row="0" Header="Memory Map" IsExpanded="False" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtReqMemory" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas" Background="#F0F8FF" Height="40" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtResMemory" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Background="#F0FFF0" Height="40" Margin="5,0,5,0"/>
                        <TextBox x:Name="TxtEvtMemory" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas" Background="#FFF0F5" Height="40" Margin="5,0,0,0"/>
                    </Grid>
                </Expander>
                <TextBox x:Name="TxtLogs" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#1E1E1E" Foreground="#D4D4D4" Height="120"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
